      "layers": [
        "L2"
      ],
      "stage": 4,
      "g1": "D-01"
    },
    {
      "program": "ELGB110",
      "paragraph": "9000-NOT-FOUND",
      "rule": "Returns M1 and the last key tried.",
      "target": "member/resolveMember.ts",
      "layers": [
        "L1"
      ],
      "stage": 2,
      "g1": "D-01"
    },
    {
      "program": "ELGB120",
