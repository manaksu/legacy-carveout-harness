      "layers": [
        "L0"
      ],
      "stage": 1
    },
    {
      "program": "ELGB100",
      "paragraph": "9000-ABEND-HANDLER",
      "rule": "On SQL or file error, sets code X9 and writes the key to ELGHIST.",
