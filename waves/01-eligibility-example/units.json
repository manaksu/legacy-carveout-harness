{
  "wave": "01-eligibility-example",
  "seam": "CLMADJ00 -> CALL 'ELGB100' USING ELGCOMM",
  "note": "Illustrative example. Program names, rules and stages are made up to show the model.",
  "units": [
    {
      "program": "ELGB100",
      "paragraph": "0000-MAINLINE",
      "rule": "Entry point. Receives ELGCOMM from CLMADJ00 and runs the steps below in order.",
      "target": "api/eligibilityHandler.ts",
      "layers": [
        "L0"
      ],
      "stage": 5,
      "g1": "D-01"
    },
    {
      "program": "ELGB100",
      "paragraph": "1000-INIT-COMMAREA",
      "rule": "Clears the response area to spaces and zero before any work.",
      "target": "api/initResponse.ts",
      "layers": [
        "L0"
      ],
      "stage": 5,
      "g1": "D-01"
    },
    {
      "program": "ELGB100",
      "paragraph": "1100-VALIDATE-REQUEST",
      "rule": "Rejects the call with code E1 when DOS is not a valid CYYMMDD date or the member key is blank.",
      "target": "api/validateRequest.ts",
      "layers": [
        "L6"
      ],
      "stage": 4,
      "ledgerRules": [
        "L-012"
      ],
      "g1": "D-01"
    },
    {
      "program": "ELGB100",
      "paragraph": "2000-CALL-MEMBER-LOOKUP",
      "rule": "Calls ELGB110 and stops with code M1 when no member is found.",
      "target": "api/eligibilityHandler.ts",
      "layers": [
        "L1"
      ],
      "stage": 4,
      "g1": "D-01"
    },
    {
      "program": "ELGB100",
      "paragraph": "3000-CALL-SPAN-RESOLVER",
      "rule": "Calls ELGB120 to pick the coverage span for the date of service.",
      "target": "api/eligibilityHandler.ts",
      "layers": [
        "L1"
      ],
      "stage": 3,
      "g1": "D-01"
    },
    {
      "program": "ELGB100",
      "paragraph": "4000-CALL-PLAN-ATTACH",
      "rule": "Calls ELGB130 to attach plan package and network tier to the chosen span.",
      "target": "api/eligibilityHandler.ts",
      "layers": [
        "L1"
      ],
      "stage": 3,
      "g1": "D-01"
    },
    {
      "program": "ELGB100",
      "paragraph": "5000-CALL-RULES",
      "rule": "Runs retro-term, grace and age-out rules in that fixed order.",
      "target": "api/eligibilityHandler.ts",
      "layers": [
        "L1"
      ],
      "stage": 2,
      "g1": "D-01"
    },
    {
      "program": "ELGB100",
      "paragraph": "8000-BUILD-RESPONSE",
      "rule": "Calls ELGB900 and moves the result back into ELGCOMM.",
