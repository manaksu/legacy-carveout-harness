      "layers": [
        "L3"
      ],
      "stage": 1
    },
    {
      "program": "ELGB110",
      "paragraph": "0000-MAIN",
      "rule": "Chooses lookup by member ID or by alternate ID, based on REQ-KEY-TYPE.",
      "target": "member/resolveMember.ts",
      "layers": [
        "L1"
      ],
      "stage": 5,
      "g1": "D-01"
    },
    {
      "program": "ELGB110",
      "paragraph": "1000-LOOKUP-BY-MBR-ID",
      "rule": "Reads MBR_MASTER by member ID and two-digit dependent suffix.",
      "target": "member/resolveMember.ts",
      "layers": [
        "L2"
      ],
      "stage": 5,
      "g1": "D-01"
    },
    {
      "program": "ELGB110",
      "paragraph": "1100-XREF-ALT-ID",
